<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>DSB Transportes</title>
  <meta name="theme-color" content="#0b3a6b">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" href="/img/icon-192.png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="DSB">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    try { var t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
<%
  const ruta = currentPath.split('?')[0];
  const cur = (href) => ((['/admin', '/cliente', '/empleado'].includes(href) ? ruta === href : ruta === href || ruta.startsWith(href + '/')) ? ' aria-current="page"' : '');
  const grupoAdmin = can('panel.admin') || can('reservas.ver_todas') || can('usuarios.gestionar') || can('tarifas.gestionar') || can('divisas.gestionar') || can('ajustes.gestionar') || can('roles.gestionar') || can('contactos.gestionar');
  // Quien entra por el panel de administración tiene todos los permisos, pero no necesita las secciones de conductor ni de cliente.
  const grupoConductor = user && user.panel !== 'admin' && (can('servicios.ver_asignados') || can('disponibilidad.gestionar'));
  const grupoCliente = user && user.panel !== 'admin' && (can('reservas.ver_propias') || can('reservas.crear_propia'));
%>
<header class="nav" id="barra">
  <a class="brand" href="/"><%- include('logo', { cls: 'logo-nav' }) %></a>
  <div class="nav-right">
    <% if (!user) { %><a class="btn" href="/login"><%= t('nav.login') %></a><% } %>
    <% if (user) { %>
      <a class="bell" href="/notificaciones" aria-label="<%= t('notif.title') %>" title="<%= t('notif.title') %>">
        <span aria-hidden="true">🔔</span><span class="count" id="notif-badge" <%= sinLeer ? '' : 'hidden' %>><%= sinLeer > 99 ? '99+' : sinLeer %></span>
      </a>
    <% } %>
    <%# Un solo menú general: todas las opciones se despliegan aquí (funciona incluso sin JavaScript) %>
    <details class="menu" id="menu">
      <summary class="menu-btn" aria-label="<%= t('nav.menu') %>"><span aria-hidden="true">☰</span><span class="menu-text"><%= t('nav.menu') %></span></summary>
      <nav class="menu-panel" aria-label="<%= t('nav.menu') %>">
        <% if (user) { %>
          <div class="menu-user"><a href="/perfil"<%- cur('/perfil') %>><strong><%= user.nombre %></strong><small><%= t('nav.profile') %></small></a></div>

          <% if (grupoAdmin) { %>
            <p class="menu-title"><%= t('menu.admin') %></p>
            <% if (can('panel.admin')) { %><a href="/admin"<%- cur('/admin') %>><%= t('nav.panel') %></a><% } %>
            <% if (can('reservas.ver_todas')) { %><a href="/admin/reservas"<%- cur('/admin/reservas') %>><%= t('nav.bookings') %></a><% } %>
            <% if (can('contactos.gestionar')) { %><a href="/admin/contactos"<%- cur('/admin/contactos') %>><%= t('nav.contacts') %></a><% } %>
            <% if (can('usuarios.gestionar')) { %><a href="/admin/usuarios"<%- cur('/admin/usuarios') %>><%= t('nav.users') %></a><% } %>
            <% if (can('tarifas.gestionar')) { %><a href="/admin/tarifas"<%- cur('/admin/tarifas') %>><%= t('nav.tariffs') %></a><% } %>
            <% if (can('divisas.gestionar')) { %><a href="/admin/divisas"<%- cur('/admin/divisas') %>><%= t('nav.currencies') %></a><% } %>
            <% if (can('ajustes.gestionar')) { %><a href="/admin/ajustes"<%- cur('/admin/ajustes') %>><%= t('nav.settings') %></a><% } %>
            <% if (can('roles.gestionar')) { %><a href="/admin/roles"<%- cur('/admin/roles') %>><%= t('nav.roles') %></a><% } %>
          <% } %>

          <% if (grupoConductor) { %>
            <p class="menu-title"><%= t('menu.driver') %></p>
            <% if (can('servicios.ver_asignados')) { %><a href="/empleado"<%- cur('/empleado') %>><%= t('nav.myServices') %></a><% } %>
            <% if (can('disponibilidad.gestionar')) { %><a href="/empleado/disponibilidad"<%- cur('/empleado/disponibilidad') %>><%= t('nav.availability') %></a><% } %>
          <% } %>

          <% if (grupoCliente) { %>
            <p class="menu-title"><%= t('menu.client') %></p>
            <% if (can('reservas.ver_propias')) { %><a href="/cliente"<%- cur('/cliente') %>><%= t('nav.myBookings') %></a><% } %>
            <% if (can('reservas.crear_propia')) { %><a href="/cliente/reservar"<%- cur('/cliente/reservar') %>><%= t('nav.book') %></a><% } %>
          <% } %>
        <% } else { %>
          <a href="/#tours"><%= t('nav.tours') %></a>
          <a href="/registro"<%- cur('/registro') %>><%= t('nav.register') %></a>
        <% } %>

        <p class="menu-title"><%= t('menu.preferences') %></p>
        <div class="menu-prefs">
          <select class="lang-select" id="lang-select" aria-label="<%= t('lang.label') %>" data-next="<%= currentPath %>">
            <% languages.forEach(l => { %><option value="<%= l.code %>" <%= l.code === lang ? 'selected' : '' %>><%= l.name %></option><% }) %>
          </select>
          <select class="lang-select" id="divisa-select" aria-label="<%= t('cur.label') %>" data-next="<%= currentPath %>">
            <% listaDivisas.forEach(c => { %><option value="<%= c %>" <%= c === divisaVista ? 'selected' : '' %>><%= c %></option><% }) %>
          </select>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="<%= t('theme.toggle') %>" title="<%= t('theme.title') %>">🌙</button>
        </div>

        <% if (user) { %><form action="/logout" method="post"><button class="menu-logout"><%= t('nav.logout') %></button></form><% } %>
      </nav>
    </details>
  </div>
</header>
<script>
  (function () {
    var root = document.documentElement, btn = document.getElementById('theme-toggle');
    function actual() {
      return root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    }
    function pintar() { btn.textContent = actual() === 'dark' ? '☀️' : '🌙'; }
    btn.addEventListener('click', function () {
      var nuevo = actual() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = nuevo;
      try { localStorage.setItem('tema', nuevo); } catch (e) {}
      pintar();
    });
    pintar();

    var div = document.getElementById('divisa-select');
    div.addEventListener('change', function () {
      location.href = '/divisa/' + div.value + '?next=' + encodeURIComponent(div.dataset.next);
    });

    // El menú se cierra al tocar fuera, con Escape o al elegir una opción.
    var menu = document.getElementById('menu');
    document.addEventListener('click', function (e) { if (menu.open && !menu.contains(e.target)) menu.open = false; });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus(); }
    });
    menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { menu.open = false; }); });

    var sel = document.getElementById('lang-select');
    sel.addEventListener('change', function () {
      location.href = '/lang/' + sel.value + '?next=' + encodeURIComponent(sel.dataset.next);
    });
  })();
</script>
<% if (user) { %><script src="/js/notificaciones.js" defer></script><% } %>
<main class="container">
