<%- include('partials/header') %>
<section class="hero">
  <%- include('partials/logo', { cls: 'logo-hero' }) %>
  <h1><%= t('hero.title') %></h1>
  <p><%= t('hero.sub') %></p>
  <a class="btn" href="/registro"><%= t('hero.cta') %></a>
</section>

<section id="tours">
  <h2><%= t('tours.title') %></h2>
  <div class="grid">
    <% tours.forEach(tour => { %>
      <article class="card">
        <h3><%= tour.nombre %></h3>
        <p><%= tour.descripcion %></p>
        <p class="muted"><%= tour.destino %> · <%= tour.duracion_hrs %> <%= t('tours.hours') %></p>
        <p class="price"><%= precioLista(tour.precio, tour.moneda) %></p>
      </article>
    <% }) %>
  </div>
</section>

<section>
  <h2><%= t('contact.title') %></h2>
  <p><%= t('contact.text') %></p>
</section>
<%- include('partials/footer') %>
