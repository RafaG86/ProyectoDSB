<% const titulo = t('tar.title') %>
<%- include('../partials/header', { titulo }) %>
<h1><%= t('tar.title') %></h1>
<p class="muted"><%= t('tar.hint') %></p>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

<form class="row" method="post" action="/admin/tarifas">
  <input name="nombre" placeholder="<%= t('tar.name') %>" maxlength="80" required>
  <select name="moneda" aria-label="<%= t('cur.label') %>">
    <% listaDivisas.forEach(c => { %><option value="<%= c %>" <%= c === 'USD' ? 'selected' : '' %>><%= c %></option><% }) %>
  </select>
  <input type="number" name="precio_km" placeholder="<%= t('tar.perKm') %>" min="0" step="any" required>
  <input type="number" name="tarifa_minima" placeholder="<%= t('tar.min') %>" min="0" step="any">
  <button class="btn"><%= t('tar.create') %></button>
</form>

<div class="table-wrap">
<table>
  <tr><th><%= t('tar.name') %></th><th><%= t('tar.perKm') %></th><th><%= t('tar.min') %></th><th><%= t('usr.status') %></th><th></th></tr>
  <% tarifas.forEach(tf => { %>
    <tr>
      <td><%= tf.nombre %></td>
      <td><%= money(tf.precio_km, tf.moneda, true) %></td>
      <td><%= money(tf.tarifa_minima, tf.moneda) %></td>
      <td><%= tf.activo ? t('usr.active') : t('usr.inactive') %></td>
      <td><a href="/admin/tarifas/<%= tf.id %>"><%= t('roles.edit') %></a></td>
    </tr>
  <% }) %>
  <% if (!tarifas.length) { %><tr><td colspan="5" class="muted"><%= t('tar.none') %></td></tr><% } %>
</table>
</div>
<%- include('../partials/footer') %>
