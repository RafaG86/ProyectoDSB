<% const titulo = t('adm.title') %>
<% const claseResp = { ok: 'est-completada', tarde: 'est-pendiente', vencido: 'est-rechazada', esperando: 'est-confirmada' } %>
<% const clasePlazo = { ok: 'est-completada', urgente: 'est-pendiente', vencido: 'est-rechazada', confirmada: 'est-confirmada', cerrada: 'est-cancelada' } %>
<%- include('../partials/header', { titulo }) %>
<h1><%= t('adm.title') %></h1>
<div class="grid">
  <div class="card stat"><span><%= stats.clientes %></span><%= t('adm.clients') %></div>
  <div class="card stat"><span><%= stats.empleados %></span><%= t('adm.employees') %></div>
  <a class="card stat" href="/admin/reservas?estado=pendiente"><span><%= stats.reservasPendientes %></span><%= t('adm.pending') %></a>
  <div class="card stat"><span><%= stats.vehiculos %></span><%= t('adm.vehicles') %></div>
  <% if (can('contactos.gestionar')) { %><a class="card stat <%= stats.contactosNuevos ? 'alerta' : '' %>" href="/admin/contactos?estado=nuevo"><span><%= stats.contactosNuevos %></span><%= t('con.statNew') %></a><% } %>
  <% if (can('pagos.verificar')) { %><a class="card stat <%= stats.pagosPorVerificar ? 'alerta' : '' %>" href="/admin/reservas?pago=en_revision"><span><%= stats.pagosPorVerificar %></span><%= t('adm.payPending') %></a><% } %>
</div>

<% if (can('reservas.ver_todas')) { %>
<h2 style="margin-top:32px"><%= t('sla.title') %></h2>
<div class="grid">
  <div class="card stat <%= metricas.sinResponderVencidas ? 'alerta' : '' %>">
    <span><%= metricas.sinResponder %></span><%= t('sla.unanswered') %>
    <small class="muted"><%= metricas.sinResponderVencidas ? t('sla.overdue').replace('{n}', metricas.sinResponderVencidas) : t('sla.allOnTime') %>
      <% if (metricas.masAntigua != null) { %> · <%= t('sla.oldest').replace('{t}', duracion(metricas.masAntigua)) %><% } %></small>
  </div>
  <div class="card stat">
    <span><%= metricas.promedio == null ? '—' : duracion(metricas.promedio) %></span><%= t('sla.average') %>
    <small class="muted"><%= t('sla.target').replace('{t}', duracion(metricas.objetivo)) %></small>
  </div>
  <div class="card stat">
    <span><%= metricas.dentroObjetivo == null ? '—' : metricas.dentroObjetivo + '%' %></span><%= t('sla.within') %>
    <small class="muted"><%= t('sla.sample').replace('{n}', metricas.respondidas) %></small>
  </div>
</div>

<h2 style="margin-top:32px"><%= t('adm.newRequests') %></h2>
<div class="table-wrap">
<table>
  <tr><th>#</th><th><%= t('bk.dateTime') %></th><th><%= t('bk.client') %></th><th><%= t('bk.service') %></th><th><%= t('bk.pax') %></th><th><%= t('sla.wait') %></th><th><%= t('sla.deadline') %></th><th><%= t('sla.driver') %></th><th></th></tr>
  <% pendientes.forEach(r => { %>
    <tr>
      <td><%= r.id %></td>
      <td class="nowrap"><%= r.fecha %><span class="sub"><%= r.hora || '—' %></span></td>
      <td><%= r.cliente %></td>
      <td><strong><%= r.tipo === 'tour' ? r.tour : t('svc.special') %></strong><span class="sub"><%= r.destino_final %></span></td>
      <td><%= r.pasajeros %></td>
      <td><span class="badge <%= claseResp[r.t.estadoRespuesta] %>"><%= r.t.respondido ? t('sla.answered') : duracion(r.t.espera) %></span></td>
      <td><span class="badge <%= clasePlazo[r.t.estadoPlazo] %>"><%= r.t.restante < 0 ? t('sla.expired') : duracion(r.t.restante) %></span></td>
      <td><span class="badge <%= { pendiente: 'est-pendiente', aceptada: 'est-completada', rechazada: 'est-rechazada', sin_asignar: 'est-cancelada' }[r.conductor_estado] %>"><%= t('cond.' + r.conductor_estado) %></span></td>
      <td><% if (r.autorizacion === 'pendiente') { %><small class="muted"><%= t('aut.needed') %></small><br><% } %><a href="/admin/reservas/<%= r.id %>"><%= t('bk.manage') %></a></td>
    </tr>
  <% }) %>
  <% if (!pendientes.length) { %><tr><td colspan="9" class="muted"><%= t('adm.noRequests') %></td></tr><% } %>
</table>
</div>
<% } %>
<%- include('../partials/footer') %>
